#: competency-slider.php
msgid "Competency Slider Block"
msgstr "Competency Slider Block"

#: slider/block.json
msgid "Competency Slider"
msgstr "Kompetenz-Slider"

#: slider/block.json
msgid "Choose a target group, select criteria and set interests and skills."
msgstr "Zielgruppe wählen, Kriterien auswählen und Interessen sowie Fähigkeiten einstellen."

#: results/block.json
msgid "Competency Results"
msgstr "Kompetenz-Ergebnisse"

#: results/block.json
msgid "Personalised continuing education catalogue – shows offers matching the selected criteria."
msgstr "Personalisierter Weiterbildungskatalog – zeigt Angebote passend zu den gewählten Kriterien."

#: includes/Classes/Blocks.php
msgid "Decrease %s"
msgstr "%s verringern"

#: includes/Classes/Blocks.php
msgid "Increase %s"
msgstr "%s erhöhen"

#: includes/Classes/Blocks.php
msgid "No criteria have been defined for this target group yet."
